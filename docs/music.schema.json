{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omr-ingestor/music.schema.json",
  "title": "music.json manifest",
  "type": "object",
  "required": ["title", "items", "style"],
  "additionalProperties": false,
  "properties": {
    "_example": {"type": "string", "description": "Only in example files"},
    "title": {"type": "string", "minLength": 1},
    "style": {"type": "string", "minLength": 1, "description": "Path of the .mss style applied with -S"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pdf", "instrument", "sha256", "expected_measures"],
        "additionalProperties": false,
        "properties": {
          "pdf": {"type": "string", "minLength": 1},
          "instrument": {"enum": ["bb-trumpet", "trombone", "flute", "alto-saxophone", "tenor-saxophone", "tuba"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "expected_measures": {"type": "integer", "minimum": 1, "description": "Denominator of the up-to-5% hand-corrected criterion"}
        }
      }
    }
  }
}
