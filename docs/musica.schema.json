{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omr-ingestor/musica.schema.json",
  "title": "Manifesto musica.json",
  "type": "object",
  "required": ["titulo", "itens", "estilo"],
  "additionalProperties": false,
  "properties": {
    "_exemplo": {"type": "string", "description": "Só em arquivos de exemplo"},
    "titulo": {"type": "string", "minLength": 1},
    "estilo": {"type": "string", "minLength": 1, "description": "Caminho do .mss aplicado com -S"},
    "itens": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pdf", "instrumento", "sha256", "compassos_esperados"],
        "additionalProperties": false,
        "properties": {
          "pdf": {"type": "string", "minLength": 1},
          "instrumento": {"enum": ["bb-trumpet", "trombone", "flute", "alto-saxophone", "tenor-saxophone", "tuba"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "compassos_esperados": {"type": "integer", "minimum": 1, "description": "Denominador do critério de até 5% corrigido"}
        }
      }
    }
  }
}
